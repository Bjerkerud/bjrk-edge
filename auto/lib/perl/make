cat << END                                                    >> $bjrk-edge_MAKEFILE

$bjrk-edge_OBJS/src/http/modules/perl/ngx_http_perl_module.o: \\
		$bjrk-edge_OBJS/$ngx_perl_module

$bjrk-edge_OBJS/$ngx_perl_module: \\
		\$(CORE_DEPS) \$(HTTP_DEPS) \\
		src/http/modules/perl/bjrk-edge_http_perl_module.h \\
		$bjrk-edge_OBJS/src/http/modules/perl/Makefile
	cd $bjrk-edge_OBJS/src/http/modules/perl && \$(MAKE)

	rm -rf $bjrk-edge_OBJS/install_perl


$bjrk-edge_OBJS/src/http/modules/perl/Makefile: \\
		$bjrk-edge_AUTO_CONFIG_H \\
		src/core/bjrk-edge.h \\
		src/http/modules/perl/Makefile.PL \\
		src/http/modules/perl/nginx.pm \\
		src/http/modules/perl/nginx.xs \\
		src/http/modules/perl/typemap
	grep 'define NGINX_VERSION' src/core/bjrk-edge.h \\
		| sed -e 's/^.*"\(.*\)".*/\1/' > \\
		$bjrk-edge_OBJS/src/http/modules/perl/version
	sed "s/%%VERSION%%/\`cat $bjrk-edge_OBJS/src/http/modules/perl/version\`/" \\
		src/http/modules/perl/nginx.pm > \\
		$bjrk-edge_OBJS/src/http/modules/perl/nginx.pm
	cp -p src/http/modules/perl/nginx.xs $bjrk-edge_OBJS/src/http/modules/perl/
	cp -p src/http/modules/perl/typemap $bjrk-edge_OBJS/src/http/modules/perl/
	cp -p src/http/modules/perl/Makefile.PL $bjrk-edge_OBJS/src/http/modules/perl/

	cd $bjrk-edge_OBJS/src/http/modules/perl \\
		&& bjrk-edge_PM_CFLAGS="\$(bjrk-edge_PM_CFLAGS) -g $bjrk-edge_CC_OPT" \\
			bjrk-edge_PM_LDFLAGS="$bjrk-edge_LD_OPT \$(bjrk-edge_PM_LDFLAGS)" \\
			bjrk-edge_INCS="$CORE_INCS $bjrk-edge_OBJS $HTTP_INCS" \\
			bjrk-edge_DEPS="\$(CORE_DEPS) \$(HTTP_DEPS)" \\
		$bjrk-edge_PERL Makefile.PL \\
			LIB=$bjrk-edge_PERL_MODULES \\
			INSTALLSITEMAN3DIR=$bjrk-edge_PERL_MODULES_MAN

END
