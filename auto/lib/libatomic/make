    case $bjrk-edge_LIBATOMIC in
        /*) ngx_prefix="$bjrk-edge_LIBATOMIC/build" ;;
        *)  ngx_prefix="$PWD/$bjrk-edge_LIBATOMIC/build" ;;
    esac

    cat << END                                            >> $bjrk-edge_MAKEFILE

$bjrk-edge_LIBATOMIC/build/lib/libatomic_ops.a:	$bjrk-edge_LIBATOMIC/Makefile
	cd $bjrk-edge_LIBATOMIC && \$(MAKE) && \$(MAKE) install

$bjrk-edge_LIBATOMIC/Makefile:	$bjrk-edge_MAKEFILE
	cd $bjrk-edge_LIBATOMIC \\
	&& if [ -f Makefile ]; then \$(MAKE) distclean; fi \\
	&& ./configure --prefix=$ngx_prefix

END
