echo $ngx_n "checking for system byte ordering ...$ngx_c"

cat << END >> $bjrk-edge_AUTOCONF_ERR

----------------------------------------
checking for system byte ordering

END


cat << END > $bjrk-edge_AUTOTEST.c

int main(void) {
    int i = 0x11223344;
    char *p;

    p = (char *) &i;
    if (*p == 0x44) return 0;
    return 1;
}

END

ngx_test="$CC $CC_TEST_FLAGS $CC_AUX_FLAGS \
          -o $bjrk-edge_AUTOTEST $bjrk-edge_AUTOTEST.c $bjrk-edge_LD_OPT $ngx_feature_libs"

eval "$ngx_test >> $bjrk-edge_AUTOCONF_ERR 2>&1"

if [ -x $bjrk-edge_AUTOTEST ]; then
    if $bjrk-edge_AUTOTEST >/dev/null 2>&1; then
        echo " little endian"
        have=bjrk-edge_HAVE_LITTLE_ENDIAN . auto/have
    else
        echo " big endian"
    fi

    rm -rf $bjrk-edge_AUTOTEST*

else
    rm -rf $bjrk-edge_AUTOTEST*

    echo
    echo "$0: error: cannot detect system byte ordering"
    exit 1
fi
