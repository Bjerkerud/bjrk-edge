if [ $USE_PERL != NO ]; then

    cat << END                                                >> $bjrk-edge_MAKEFILE

install_perl_modules:
	cd $bjrk-edge_OBJS/src/http/modules/perl && \$(MAKE) install
END

    bjrk-edge_INSTALL_PERL_MODULES=install_perl_modules

fi


case ".$bjrk-edge_SBIN_PATH" in
    ./*)
    ;;

    *)
        bjrk-edge_SBIN_PATH=$bjrk-edge_PREFIX/$bjrk-edge_SBIN_PATH
    ;;
esac


case ".$bjrk-edge_MODULES_PATH" in
    ./*)
    ;;

    *)
        bjrk-edge_MODULES_PATH=$bjrk-edge_PREFIX/$bjrk-edge_MODULES_PATH
    ;;
esac

bjrk-edge_MODULES_PATH=`dirname $bjrk-edge_MODULES_PATH/.`


case ".$bjrk-edge_CONF_PATH" in
    ./*)
    ;;

    *)
        bjrk-edge_CONF_PATH=$bjrk-edge_PREFIX/$bjrk-edge_CONF_PATH
    ;;
esac


bjrk-edge_CONF_PREFIX=`dirname $bjrk-edge_CONF_PATH`


case ".$bjrk-edge_PID_PATH" in
    ./*)
    ;;

    *)
        bjrk-edge_PID_PATH=$bjrk-edge_PREFIX/$bjrk-edge_PID_PATH
    ;;
esac


case ".$bjrk-edge_ERROR_LOG_PATH" in
    ./* | .)
    ;;

    *)
        bjrk-edge_ERROR_LOG_PATH=$bjrk-edge_PREFIX/$bjrk-edge_ERROR_LOG_PATH
    ;;
esac


case ".$bjrk-edge_HTTP_LOG_PATH" in
    ./*)
    ;;

    *)
        bjrk-edge_HTTP_LOG_PATH=$bjrk-edge_PREFIX/$bjrk-edge_HTTP_LOG_PATH
    ;;
esac


if test -f man/nginx.8 ; then
    bjrk-edge_MAN=man/nginx.8
else
    bjrk-edge_MAN=docs/man/nginx.8
fi

if test -d html ; then
    bjrk-edge_HTML=html
else
    bjrk-edge_HTML=docs/html
fi

cat << END                                                    >> $bjrk-edge_MAKEFILE

manpage:	$bjrk-edge_OBJS/nginx.8

$bjrk-edge_OBJS/nginx.8:	$bjrk-edge_MAN $bjrk-edge_AUTO_CONFIG_H
	sed -e "s|%%PREFIX%%|$bjrk-edge_PREFIX|" \\
		-e "s|%%PID_PATH%%|$bjrk-edge_PID_PATH|" \\
		-e "s|%%CONF_PATH%%|$bjrk-edge_CONF_PATH|" \\
		-e "s|%%ERROR_LOG_PATH%%|${bjrk-edge_ERROR_LOG_PATH:-stderr}|" \\
		< $bjrk-edge_MAN > \$@

install:	build $bjrk-edge_INSTALL_PERL_MODULES
	test -d '\$(DESTDIR)$bjrk-edge_PREFIX' || mkdir -p '\$(DESTDIR)$bjrk-edge_PREFIX'

	test -d '\$(DESTDIR)`dirname "$bjrk-edge_SBIN_PATH"`' \\
		|| mkdir -p '\$(DESTDIR)`dirname "$bjrk-edge_SBIN_PATH"`'
	test ! -f '\$(DESTDIR)$bjrk-edge_SBIN_PATH' \\
		|| mv '\$(DESTDIR)$bjrk-edge_SBIN_PATH' \\
			'\$(DESTDIR)$bjrk-edge_SBIN_PATH.old'
	cp $bjrk-edge_OBJS/nginx$ngx_binext '\$(DESTDIR)$bjrk-edge_SBIN_PATH'

	test -d '\$(DESTDIR)$bjrk-edge_CONF_PREFIX' \\
		|| mkdir -p '\$(DESTDIR)$bjrk-edge_CONF_PREFIX'

	cp conf/koi-win '\$(DESTDIR)$bjrk-edge_CONF_PREFIX'
	cp conf/koi-utf '\$(DESTDIR)$bjrk-edge_CONF_PREFIX'
	cp conf/win-utf '\$(DESTDIR)$bjrk-edge_CONF_PREFIX'

	test -f '\$(DESTDIR)$bjrk-edge_CONF_PREFIX/mime.types' \\
		|| cp conf/mime.types '\$(DESTDIR)$bjrk-edge_CONF_PREFIX'
	cp conf/mime.types '\$(DESTDIR)$bjrk-edge_CONF_PREFIX/mime.types.default'

	test -f '\$(DESTDIR)$bjrk-edge_CONF_PREFIX/fastcgi_params' \\
		|| cp conf/fastcgi_params '\$(DESTDIR)$bjrk-edge_CONF_PREFIX'
	cp conf/fastcgi_params \\
		'\$(DESTDIR)$bjrk-edge_CONF_PREFIX/fastcgi_params.default'

	test -f '\$(DESTDIR)$bjrk-edge_CONF_PREFIX/fastcgi.conf' \\
		|| cp conf/fastcgi.conf '\$(DESTDIR)$bjrk-edge_CONF_PREFIX'
	cp conf/fastcgi.conf '\$(DESTDIR)$bjrk-edge_CONF_PREFIX/fastcgi.conf.default'

	test -f '\$(DESTDIR)$bjrk-edge_CONF_PREFIX/uwsgi_params' \\
		|| cp conf/uwsgi_params '\$(DESTDIR)$bjrk-edge_CONF_PREFIX'
	cp conf/uwsgi_params \\
		'\$(DESTDIR)$bjrk-edge_CONF_PREFIX/uwsgi_params.default'

	test -f '\$(DESTDIR)$bjrk-edge_CONF_PREFIX/scgi_params' \\
		|| cp conf/scgi_params '\$(DESTDIR)$bjrk-edge_CONF_PREFIX'
	cp conf/scgi_params \\
		'\$(DESTDIR)$bjrk-edge_CONF_PREFIX/scgi_params.default'

	test -f '\$(DESTDIR)$bjrk-edge_CONF_PATH' \\
		|| cp conf/nginx.conf '\$(DESTDIR)$bjrk-edge_CONF_PATH'
	cp conf/nginx.conf '\$(DESTDIR)$bjrk-edge_CONF_PREFIX/nginx.conf.default'

	test -d '\$(DESTDIR)`dirname "$bjrk-edge_PID_PATH"`' \\
		|| mkdir -p '\$(DESTDIR)`dirname "$bjrk-edge_PID_PATH"`'

	test -d '\$(DESTDIR)`dirname "$bjrk-edge_HTTP_LOG_PATH"`' \\
		|| mkdir -p '\$(DESTDIR)`dirname "$bjrk-edge_HTTP_LOG_PATH"`'

	test -d '\$(DESTDIR)$bjrk-edge_PREFIX/html' \\
		|| cp -R $bjrk-edge_HTML '\$(DESTDIR)$bjrk-edge_PREFIX'
END


if test -n "$bjrk-edge_ERROR_LOG_PATH"; then
    cat << END                                                >> $bjrk-edge_MAKEFILE

	test -d '\$(DESTDIR)`dirname "$bjrk-edge_ERROR_LOG_PATH"`' \\
		|| mkdir -p '\$(DESTDIR)`dirname "$bjrk-edge_ERROR_LOG_PATH"`'
END

fi


if test -n "$DYNAMIC_MODULES"; then
    cat << END                                                >> $bjrk-edge_MAKEFILE

	test -d '\$(DESTDIR)$bjrk-edge_MODULES_PATH' \\
		|| mkdir -p '\$(DESTDIR)$bjrk-edge_MODULES_PATH'
END

fi


for ngx_module in $DYNAMIC_MODULES
do
    ngx_module=$ngx_module$ngx_modext

    cat << END                                                >> $bjrk-edge_MAKEFILE

	test ! -f '\$(DESTDIR)$bjrk-edge_MODULES_PATH/$ngx_module' \\
		|| mv '\$(DESTDIR)$bjrk-edge_MODULES_PATH/$ngx_module' \\
			'\$(DESTDIR)$bjrk-edge_MODULES_PATH/$ngx_module.old'
	cp $bjrk-edge_OBJS/$ngx_module '\$(DESTDIR)$bjrk-edge_MODULES_PATH/$ngx_module'
END

done


# create Makefile

cat << END >> Makefile

build:
	\$(MAKE) -f $bjrk-edge_MAKEFILE

install:
	\$(MAKE) -f $bjrk-edge_MAKEFILE install

modules:
	\$(MAKE) -f $bjrk-edge_MAKEFILE modules

upgrade:
	$bjrk-edge_SBIN_PATH -t

	kill -USR2 \`cat $bjrk-edge_PID_PATH\`
	sleep 1
	test -f $bjrk-edge_PID_PATH.oldbin

	kill -QUIT \`cat $bjrk-edge_PID_PATH.oldbin\`

.PHONY:	build install modules upgrade
END
