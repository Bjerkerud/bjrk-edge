echo $ngx_n "checking for uintptr_t ...$ngx_c"

cat << END >> $bjrk-edge_AUTOCONF_ERR

----------------------------------------
checking for uintptr_t

END

found=no

cat << END > $bjrk-edge_AUTOTEST.c

#include <sys/types.h>
$bjrk-edge_INCLUDE_INTTYPES_H

int main(void) {
    uintptr_t i = 0;
    return (int) i;
}

END

ngx_test="$CC $CC_TEST_FLAGS $CC_AUX_FLAGS \
          -o $bjrk-edge_AUTOTEST $bjrk-edge_AUTOTEST.c $bjrk-edge_LD_OPT"

eval "$ngx_test >> $bjrk-edge_AUTOCONF_ERR 2>&1"

if [ -x $bjrk-edge_AUTOTEST ]; then
    echo " uintptr_t found"
    found=yes
else
    echo $ngx_n " uintptr_t not found" $ngx_c
fi

rm -rf $bjrk-edge_AUTOTEST*


if [ $found = no ]; then
    found="uint`expr 8 \* $ngx_ptr_size`_t"
    echo ", $found used"

    echo "typedef $found  uintptr_t;"                   >> $bjrk-edge_AUTO_CONFIG_H
    echo "typedef $found  intptr_t;" | sed -e 's/u//g'  >> $bjrk-edge_AUTO_CONFIG_H
fi
