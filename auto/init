bjrk-edge_MAKEFILE=$bjrk-edge_OBJS/Makefile
bjrk-edge_MODULES_C=$bjrk-edge_OBJS/bjrk-edge_modules.c

bjrk-edge_AUTO_HEADERS_H=$bjrk-edge_OBJS/bjrk-edge_auto_headers.h
bjrk-edge_AUTO_CONFIG_H=$bjrk-edge_OBJS/bjrk-edge_auto_config.h

bjrk-edge_AUTOTEST=$bjrk-edge_OBJS/autotest
bjrk-edge_AUTOCONF_ERR=$bjrk-edge_OBJS/autoconf.err

# STUBs
bjrk-edge_ERR=$bjrk-edge_OBJS/autoconf.err
MAKEFILE=$bjrk-edge_OBJS/Makefile


bjrk-edge_PCH=
bjrk-edge_USE_PCH=


# check the echo's "-n" option and "\c" capability

if echo "test\c" | grep c >/dev/null; then

    if echo -n test | grep n >/dev/null; then
        ngx_n=
        ngx_c=

    else
        ngx_n=-n
        ngx_c=
    fi

else
    ngx_n=
    ngx_c='\c'
fi


# create Makefile

cat << END > Makefile

default:	build

clean:
	rm -rf Makefile $bjrk-edge_OBJS

.PHONY:	default clean
END
