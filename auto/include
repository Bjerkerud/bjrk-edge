echo $ngx_n "checking for $ngx_include ...$ngx_c"

cat << END >> $bjrk-edge_AUTOCONF_ERR

----------------------------------------
checking for $ngx_include

END


ngx_found=no

cat << END > $bjrk-edge_AUTOTEST.c

$bjrk-edge_INCLUDE_SYS_PARAM_H
#include <$ngx_include>

int main(void) {
    return 0;
}

END


ngx_test="$CC -o $bjrk-edge_AUTOTEST $bjrk-edge_AUTOTEST.c"

eval "$ngx_test >> $bjrk-edge_AUTOCONF_ERR 2>&1"

if [ -x $bjrk-edge_AUTOTEST ]; then

    ngx_found=yes

    echo " found"

    ngx_name=`echo $ngx_include \
              | tr abcdefghijklmnopqrstuvwxyz/. ABCDEFGHIJKLMNOPQRSTUVWXYZ__`


    have=bjrk-edge_HAVE_$ngx_name . auto/have_headers

    eval "bjrk-edge_INCLUDE_$ngx_name='#include <$ngx_include>'"

else
    echo " not found"

    echo "----------"    >> $bjrk-edge_AUTOCONF_ERR
    cat $bjrk-edge_AUTOTEST.c  >> $bjrk-edge_AUTOCONF_ERR
    echo "----------"    >> $bjrk-edge_AUTOCONF_ERR
    echo $ngx_test       >> $bjrk-edge_AUTOCONF_ERR
    echo "----------"    >> $bjrk-edge_AUTOCONF_ERR
fi

rm -rf $bjrk-edge_AUTOTEST*
