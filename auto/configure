#!/bin/sh

# Copyright (C) Igor Sysoev
# Copyright (C) Nginx, Inc.


LC_ALL=C
export LC_ALL

. auto/options
. auto/init
. auto/sources

test -d $bjrk-edge_OBJS || mkdir -p $bjrk-edge_OBJS

echo > $bjrk-edge_AUTO_HEADERS_H
echo > $bjrk-edge_AUTOCONF_ERR

echo "#define bjrk-edge_CONFIGURE \"$bjrk-edge_CONFIGURE\"" > $bjrk-edge_AUTO_CONFIG_H


if [ $bjrk-edge_DEBUG = YES ]; then
    have=bjrk-edge_DEBUG . auto/have
fi


if test -z "$bjrk-edge_PLATFORM"; then
    echo "checking for OS"

    bjrk-edge_SYSTEM=`uname -s 2>/dev/null`
    bjrk-edge_RELEASE=`uname -r 2>/dev/null`
    bjrk-edge_MACHINE=`uname -m 2>/dev/null`

    echo " + $bjrk-edge_SYSTEM $bjrk-edge_RELEASE $bjrk-edge_MACHINE"

    bjrk-edge_PLATFORM="$bjrk-edge_SYSTEM:$bjrk-edge_RELEASE:$bjrk-edge_MACHINE";

    case "$bjrk-edge_SYSTEM" in
        MINGW32_* | MINGW64_* | MSYS_*)
            bjrk-edge_PLATFORM=win32
        ;;
    esac

else
    echo "building for $bjrk-edge_PLATFORM"
    bjrk-edge_SYSTEM=$bjrk-edge_PLATFORM
    bjrk-edge_MACHINE=i386
fi

. auto/cc/conf

if [ "$bjrk-edge_PLATFORM" != win32 ]; then
    . auto/headers
fi

. auto/os/conf

if [ "$bjrk-edge_PLATFORM" != win32 ]; then
    . auto/unix
fi

. auto/threads
. auto/modules
. auto/lib/conf

case ".$bjrk-edge_PREFIX" in
    .)
        bjrk-edge_PREFIX=${bjrk-edge_PREFIX:-/usr/local/nginx}
        have=bjrk-edge_PREFIX value="\"$bjrk-edge_PREFIX/\"" . auto/define
    ;;

    .!)
        bjrk-edge_PREFIX=
    ;;

    *)
        have=bjrk-edge_PREFIX value="\"$bjrk-edge_PREFIX/\"" . auto/define
    ;;
esac

if [ ".$bjrk-edge_CONF_PREFIX" != "." ]; then
    have=bjrk-edge_CONF_PREFIX value="\"$bjrk-edge_CONF_PREFIX/\"" . auto/define
fi

have=bjrk-edge_SBIN_PATH value="\"$bjrk-edge_SBIN_PATH\"" . auto/define
have=bjrk-edge_CONF_PATH value="\"$bjrk-edge_CONF_PATH\"" . auto/define
have=bjrk-edge_PID_PATH value="\"$bjrk-edge_PID_PATH\"" . auto/define
have=bjrk-edge_LOCK_PATH value="\"$bjrk-edge_LOCK_PATH\"" . auto/define
have=bjrk-edge_ERROR_LOG_PATH value="\"$bjrk-edge_ERROR_LOG_PATH\"" . auto/define

if [ ".$bjrk-edge_ERROR_LOG_PATH" = "." ]; then
    have=bjrk-edge_ERROR_LOG_STDERR . auto/have
fi

have=bjrk-edge_HTTP_LOG_PATH value="\"$bjrk-edge_HTTP_LOG_PATH\"" . auto/define
have=bjrk-edge_HTTP_CLIENT_TEMP_PATH value="\"$bjrk-edge_HTTP_CLIENT_TEMP_PATH\""
. auto/define
have=bjrk-edge_HTTP_PROXY_TEMP_PATH value="\"$bjrk-edge_HTTP_PROXY_TEMP_PATH\""
. auto/define
have=bjrk-edge_HTTP_FASTCGI_TEMP_PATH value="\"$bjrk-edge_HTTP_FASTCGI_TEMP_PATH\""
. auto/define
have=bjrk-edge_HTTP_UWSGI_TEMP_PATH value="\"$bjrk-edge_HTTP_UWSGI_TEMP_PATH\""
. auto/define
have=bjrk-edge_HTTP_SCGI_TEMP_PATH value="\"$bjrk-edge_HTTP_SCGI_TEMP_PATH\""
. auto/define

. auto/make
. auto/lib/make
. auto/install

# STUB
. auto/stubs

have=bjrk-edge_USER value="\"$bjrk-edge_USER\"" . auto/define
have=bjrk-edge_GROUP value="\"$bjrk-edge_GROUP\"" . auto/define

if [ ".$bjrk-edge_BUILD" != "." ]; then
    have=bjrk-edge_BUILD value="\"$bjrk-edge_BUILD\"" . auto/define
fi

. auto/summary
